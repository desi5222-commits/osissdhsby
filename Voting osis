    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, onSnapshot, setDoc, updateDoc } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Global State (Fully Editable)
        window.appState = {
            status: 'LIVE', // 'NOT_STARTED', 'LIVE', 'CLOSED'
            jefeesVotes: 0,
            aubaryVotes: 0,
            schoolName: 'SEKOLAH DIAN HARAPAN SURABAYA',
            electionTitle: 'STUDENT COUNCIL PRESIDENT ELECTION',
            academicYear: '2026/2027',
            candidate1Name: 'JEFEES',
            candidate2Name: 'AUBARY',
            kioskMode: true,
            autoResetDelay: 4,
            customImages: {
                logo: '',
                bg: '',
                jefees: '',
                aubary: ''
            }
        };

        window.selectedCandidate = null;
        window.isAdminAuthenticated = false;
        window.kioskTimer = null;

        let db = null;
        let auth = null;
        let electionDocRef = null;

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'sdh-surabaya-election-2026';

        // Local Sync Broadcast Channel
        const broadcast = new BroadcastChannel('sdh_election_channel');

        async function initFirebase() {
            try {
                if (typeof __firebase_config !== 'undefined' && __firebase_config) {
                    const firebaseConfig = JSON.parse(__firebase_config);
                    const app = initializeApp(firebaseConfig);
                    auth = getAuth(app);
                    db = getFirestore(app);

                    if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                        await signInWithCustomToken(auth, __initial_auth_token);
                    } else {
                        await signInAnonymously(auth);
                    }

                    electionDocRef = doc(db, 'artifacts', appId, 'public', 'data', 'sdh_election_state', 'current_state');

                    onSnapshot(electionDocRef, (docSnap) => {
                        if (docSnap.exists()) {
                            const data = docSnap.data();
                            window.appState = { ...window.appState, ...data };
                            updateUI();
                        } else {
                            setDoc(electionDocRef, window.appState);
                        }
                    }, (error) => {
                        console.warn("Firestore snapshot error, falling back to local sync:", error);
                        setupLocalSync();
                    });
                } else {
                    setupLocalSync();
                }
            } catch (err) {
                console.warn("Firebase setup failed or offline, using local state sync:", err);
                setupLocalSync();
            }
        }

        function setupLocalSync() {
            const localSaved = localStorage.getItem('sdh_election_local_state');
            if (localSaved) {
                try { window.appState = JSON.parse(localSaved); } catch(e){}
            }
            updateUI();

            broadcast.onmessage = (event) => {
                if (event.data) {
                    window.appState = event.data;
                    updateUI();
                }
            };
        }

        window.saveStateToBackend = async function(newState) {
            window.appState = { ...window.appState, ...newState };
            updateUI();

            localStorage.setItem('sdh_election_local_state', JSON.stringify(window.appState));
            broadcast.postMessage(window.appState);

            if (electionDocRef) {
                try {
                    await setDoc(electionDocRef, window.appState, { merge: true });
                } catch (e) {
                    console.error("Error writing to Firestore:", e);
                }
            }
        };

        window.addEventListener('DOMContentLoaded', () => {
            initFirebase();
            checkDeviceVotedStatus();
            checkUrlParams();
        });
    </script>

    <script>
        function checkUrlParams() {
            const urlParams = new URLSearchParams(window.location.search);
            const mode = urlParams.get('mode') || urlParams.get('view');
            const hash = window.location.hash;

            // Memeriksa jika URL memiliki parameter mode=voting atau hashtag #voting
            if (mode === 'voting' || mode === 'vote' || hash === '#voting' || hash === '#vote') {
                switchView('voting');
                
                // Jika ingin menyembunyikan tombol 'Main Screen' di bilik suara khusus
                if (urlParams.get('standalone') === 'true' || urlParams.get('kiosk') === 'true') {
                    const btnMain = document.getElementById('btn-view-main');
                    if (btnMain) btnMain.classList.add('hidden');
                }
            }
