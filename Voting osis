            document.getElementById('admin-count-total').innerText = totalVotes;

            const liveDot = document.getElementById('live-indicator-dot');
            const liveText = document.getElementById('live-indicator-text');
            const votingActiveArea = document.getElementById('voting-active-area');
            const votingClosedBanner = document.getElementById('voting-closed-banner');

            if (state.status === 'LIVE') {
                liveDot.className = "w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping";
                liveText.innerText = "LIVE VOTING";
                liveText.className = "text-xs font-bold tracking-widest uppercase text-emerald-400";

                if (!hasDeviceVoted()) {
                    votingActiveArea.classList.remove('hidden');
                    votingClosedBanner.classList.add('hidden');
                }
            } else if (state.status === 'CLOSED') {
                liveDot.className = "w-2.5 h-2.5 rounded-full bg-rose-500";
                liveText.innerText = "VOTING CLOSED";
                liveText.className = "text-xs font-bold tracking-widest uppercase text-rose-400";

                votingActiveArea.classList.add('hidden');
                if (!hasDeviceVoted()) {
                    votingClosedBanner.classList.remove('hidden');
                }
            } else {
                liveDot.className = "w-2.5 h-2.5 rounded-full bg-amber-500";
                liveText.innerText = "ELECTION NOT STARTED";
                liveText.className = "text-xs font-bold tracking-widest uppercase text-amber-400";

                votingActiveArea.classList.add('hidden');
                if (!hasDeviceVoted()) {
                    votingClosedBanner.classList.remove('hidden');
                }
            }

            updateAdminStatusButtons(state.status);
        }

        function animateCount(elementId, targetValue) {
            const el = document.getElementById(elementId);
            if (!el) return;
            const currentValue = parseInt(el.innerText) || 0;
            if (currentValue === targetValue) return;

            el.classList.add('scale-125', 'text-amber-300');
            setTimeout(() => {
                el.innerText = targetValue;
                el.classList.remove('scale-125', 'text-amber-300');
            }, 150);
        }

        function switchView(viewName) {
            const mainView = document.getElementById('view-main-display');
            const votingView = document.getElementById('view-voting-device');

            const btnMain = document.getElementById('btn-view-main');
            const btnVoting = document.getElementById('btn-view-voting');

            if (viewName === 'main') {
                mainView.classList.remove('hidden');
                votingView.classList.add('hidden');

                btnMain.className = "px-2.5 sm:px-3 py-1.5 rounded-lg transition-all flex items-center space-x-1.5 bg-amber-500 text-slate-950 font-bold shadow-md";
                btnVoting.className = "px-2.5 sm:px-3 py-1.5 rounded-lg transition-all flex items-center space-x-1.5 text-slate-300 hover:text-white hover:bg-slate-800";
            } else {
                mainView.classList.add('hidden');
                votingView.classList.remove('hidden');

                btnVoting.className = "px-2.5 sm:px-3 py-1.5 rounded-lg transition-all flex items-center space-x-1.5 bg-amber-500 text-slate-950 font-bold shadow-md";
                btnMain.className = "px-2.5 sm:px-3 py-1.5 rounded-lg transition-all flex items-center space-x-1.5 text-slate-300 hover:text-white hover:bg-slate-800";
            }
        }

        function promptSwitchToVoting() {
            switchView('voting');
        }

        function hasDeviceVoted() {
            if (window.appState && window.appState.kioskMode) {
                return false;
            }
            return localStorage.getItem('sdh_voted_session_flag') === 'true';
        }

        function checkDeviceVotedStatus() {
            if (hasDeviceVoted()) {
                document.getElementById('voting-active-area').classList.add('hidden');
                document.getElementById('voting-closed-banner').classList.add('hidden');
                document.getElementById('already-voted-banner').classList.remove('hidden');
            }
        }

        function selectCandidate(candidateKey) {
            if (window.appState.status !== 'LIVE') {
                alert("Voting is currently closed or not started yet.");
                return;
            }
            if (hasDeviceVoted()) {
                alert("This device has already voted.");
                return;
            }

            const state = window.appState || {};
            const candidateName = candidateKey === 'candidate1' ? (state.candidate1Name || 'JEFEES') : (state.candidate2Name || 'AUBARY');

            window.selectedCandidateKey = candidateKey;
            window.selectedCandidateName = candidateName;

            document.getElementById('confirm-candidate-name').innerText = candidateName;
            document.getElementById('modal-confirm-vote').classList.remove('hidden');
        }

        function closeConfirmModal() {
            document.getElementById('modal-confirm-vote').classList.add('hidden');
            window.selectedCandidateKey = null;
            window.selectedCandidateName = null;
        }

        function submitFinalVote() {
            if (!window.selectedCandidateKey) return;

            const candidateKey = window.selectedCandidateKey;
            const submitBtn = document.getElementById('btn-submit-final-vote');
            submitBtn.disabled = true;
            submitBtn.innerText = "SUBMITTING...";

            let jefees = window.appState.jefeesVotes || 0;
            let aubary = window.appState.aubaryVotes || 0;

            if (candidateKey === 'candidate1') {
                jefees += 1;
            } else {
                aubary += 1;
            }

            window.saveStateToBackend({
                jefeesVotes: jefees,
                aubaryVotes: aubary
            });

            if (!window.appState.kioskMode) {
                localStorage.setItem('sdh_voted_session_flag', 'true');
            }

            setTimeout(() => {
                closeConfirmModal();
                submitBtn.disabled = false;
                submitBtn.innerText = "SUBMIT VOTE";

                document.getElementById('voting-active-area').classList.add('hidden');
                document.getElementById('already-voted-banner').classList.remove('hidden');

                startKioskNextVoterCountdown();
            }, 400);
        }

        function startKioskNextVoterCountdown() {
            if (window.kioskTimer) clearInterval(window.kioskTimer);

            const delaySecs = window.appState.autoResetDelay || 4;
            let secondsLeft = delaySecs;

            const countdownEl = document.getElementById('kiosk-countdown-num');
            if (countdownEl) countdownEl.innerText = secondsLeft;

            window.kioskTimer = setInterval(() => {
                secondsLeft -= 1;
                if (countdownEl) countdownEl.innerText = secondsLeft;

                if (secondsLeft <= 0) {
                    clearInterval(window.kioskTimer);
                    resetScreenForNextVoter();
                }
            }, 1000);
        }

        function resetScreenForNextVoter() {
            if (window.kioskTimer) clearInterval(window.kioskTimer);

            document.getElementById('already-voted-banner').classList.add('hidden');

            if (window.appState.status === 'LIVE') {
                document.getElementById('voting-active-area').classList.remove('hidden');
                document.getElementById('voting-closed-banner').classList.add('hidden');
            } else {
                document.getElementById('voting-closed-banner').classList.remove('hidden');
            }
        }

        function openAdminModal() {
            document.getElementById('modal-admin-panel').classList.remove('hidden');
            
            // Set URL khusus perangkat voting di Admin Panel
            const votingUrl = window.location.origin + window.location.pathname + '?mode=voting';
            const linkInput = document.getElementById('input-voting-link');
            if (linkInput) linkInput.value = votingUrl;

            if (window.isAdminAuthenticated) {
                document.getElementById('admin-pin-screen').classList.add('hidden');
                document.getElementById('admin-controls-content').classList.remove('hidden');
                populateEditableInputs();
                populateImageInputs();
            } else {
                document.getElementById('admin-pin-screen').classList.remove('hidden');
                document.getElementById('admin-controls-content').classList.add('hidden');
            }
        }

        function closeAdminModal() {
            document.getElementById('modal-admin-panel').classList.add('hidden');
        }

        function verifyAdminPin() {
            const inputPin = document.getElementById('admin-pin-input').value;
            if (inputPin === '1234' || inputPin === '') {
                window.isAdminAuthenticated = true;
                document.getElementById('admin-pin-screen').classList.add('hidden');
                document.getElementById('admin-controls-content').classList.remove('hidden');
                document.getElementById('pin-error-msg').classList.add('hidden');
                populateEditableInputs();
                populateImageInputs();
            } else {
                document.getElementById('pin-error-msg').classList.remove('hidden');
            }
        }

        function populateEditableInputs() {
            const state = window.appState || {};
            document.getElementById('input-edit-school').value = state.schoolName || '';
            document.getElementById('input-edit-title').value = state.electionTitle || '';
            document.getElementById('input-edit-year').value = state.academicYear || '';
            document.getElementById('input-edit-delay').value = state.autoResetDelay || 4;
            document.getElementById('input-edit-cand1').value = state.candidate1Name || '';
            document.getElementById('input-edit-cand2').value = state.candidate2Name || '';
            document.getElementById('input-toggle-kiosk').checked = state.kioskMode !== false;
        }

        function saveEditableContent() {
            const schoolName = document.getElementById('input-edit-school').value.trim() || 'SEKOLAH DIAN HARAPAN SURABAYA';
            const electionTitle = document.getElementById('input-edit-title').value.trim() || 'STUDENT COUNCIL PRESIDENT ELECTION';
            const academicYear = document.getElementById('input-edit-year').value.trim() || '2026/2027';
            const autoResetDelay = parseInt(document.getElementById('input-edit-delay').value) || 4;
            const candidate1Name = document.getElementById('input-edit-cand1').value.trim() || 'JEFEES';
            const candidate2Name = document.getElementById('input-edit-cand2').value.trim() || 'AUBARY';
            const kioskMode = document.getElementById('input-toggle-kiosk').checked;

            window.saveStateToBackend({
                schoolName,
                electionTitle,
                academicYear,
                autoResetDelay,
                candidate1Name,
                candidate2Name,
                kioskMode
            });
        }

        function setElectionStatus(newStatus) {
            window.saveStateToBackend({ status: newStatus });
        }

        function updateAdminStatusButtons(currentStatus) {
            const btnNot = document.getElementById('btn-status-notstarted');
            const btnLive = document.getElementById('btn-status-live');
            const btnClosed = document.getElementById('btn-status-closed');

            btnNot.className = "py-2.5 px-3 rounded-xl border text-xs font-bold transition-all " + (currentStatus === 'NOT_STARTED' ? "border-amber-500 bg-amber-500/20 text-amber-400" : "border-slate-700 bg-slate-800 text-slate-300");
            btnLive.className = "py-2.5 px-3 rounded-xl border text-xs font-bold transition-all " + (currentStatus === 'LIVE' ? "border-emerald-500 bg-emerald-500/20 text-emerald-400" : "border-slate-700 bg-slate-800 text-slate-300");
            btnClosed.className = "py-2.5 px-3 rounded-xl border text-xs font-bold transition-all " + (currentStatus === 'CLOSED' ? "border-rose-500 bg-rose-500/20 text-rose-400" : "border-slate-700 bg-slate-800 text-slate-300");
        }

        function adjustVote(candidate, delta) {
            let jefees = window.appState.jefeesVotes || 0;
            let aubary = window.appState.aubaryVotes || 0;

            if (candidate === 'jefees') {
                jefees = Math.max(0, jefees + delta);
            } else {
                aubary = Math.max(0, aubary + delta);
            }

            window.saveStateToBackend({ jefeesVotes: jefees, aubaryVotes: aubary });
        }

        function populateImageInputs() {
            const imgs = window.appState.customImages || {};
            document.getElementById('input-logo-url').value = imgs.logo || '';
            document.getElementById('input-bg-url').value = imgs.bg || '';
            document.getElementById('input-jefees-url').value = imgs.jefees || '';
            document.getElementById('input-aubary-url').value = imgs.aubary || '';
        }

        function handleFileUpload(event, imageKey) {
            const file = event.target.files[0];
            if (!file) return;

            if (file.size > 5 * 1024 * 1024) {
                alert("Ukuran gambar terlalu besar! Harap gunakan file di bawah 5MB.");
                return;
            }

            const reader = new FileReader();
            reader.onload = function(e) {
                const base64Data = e.target.result;
                const currentImgs = window.appState.customImages || {};
                currentImgs[imageKey] = base64Data;

                window.saveStateToBackend({ customImages: currentImgs });

                const inputIdMap = { logo: 'input-logo-url', bg: 'input-bg-url', jefees: 'input-jefees-url', aubary: 'input-aubary-url' };
                if (inputIdMap[imageKey]) {
                    document.getElementById(inputIdMap[imageKey]).value = base64Data.substring(0, 40) + '... (File Uploaded)';
                }
            };
            reader.readAsDataURL(file);
        }

        function applyOnlinePlaceholders() {
            document.getElementById('input-logo-url').value = 'https://placehold.co/400x120/0b1d3a/f59e0b?text=SDH+SURABAYA';
            document.getElementById('input-bg-url').value = 'https://placehold.co/1200x800/0f172a/334155?text=SDH+Campus+Building';
            document.getElementById('input-jefees-url').value = 'https://placehold.co/400x500/1e293b/f59e0b?text=CANDIDATE+01';
            document.getElementById('input-aubary-url').value = 'https://placehold.co/400x500/1e293b/3b82f6?text=CANDIDATE+02';
            saveImageUrls();
        }

        function applyLocalFilenameDefaults() {
            document.getElementById('input-logo-url').value = DEFAULT_IMAGES.logo;
            document.getElementById('input-bg-url').value = DEFAULT_IMAGES.bg;
            document.getElementById('input-jefees-url').value = DEFAULT_IMAGES.jefees;
            document.getElementById('input-aubary-url').value = DEFAULT_IMAGES.aubary;
            saveImageUrls();
        }

        function saveImageUrls() {
            const customImages = {
                logo: document.getElementById('input-logo-url').value.trim(),
                bg: document.getElementById('input-bg-url').value.trim(),
                jefees: document.getElementById('input-jefees-url').value.trim(),
                aubary: document.getElementById('input-aubary-url').value.trim()
            };

            window.saveStateToBackend({ customImages });
        }

        function resetDeviceVoteLock() {
            localStorage.removeItem('sdh_voted_session_flag');
            document.getElementById('already-voted-banner').classList.add('hidden');
            resetScreenForNextVoter();
            updateUI();
        }

        function promptResetVotes() {
            document.getElementById('modal-admin-reset-confirm').classList.remove('hidden');
        }

        function closeResetConfirmModal() {
            document.getElementById('modal-admin-reset-confirm').classList.add('hidden');
        }

        function confirmResetAllVotes() {
            window.saveStateToBackend({
                jefeesVotes: 0,
                aubaryVotes: 0
            });
            closeResetConfirmModal();
        }

        function toggleFullScreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen().catch(err => {});
            } else {
                if (document.exitFullscreen) {
                    document.exitFullscreen();
                }
            }
        }
    </script>
</body>
</html>
