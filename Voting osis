            document.getElementById('admin-label-jefees').innerText = cand1Name + ':';
            document.getElementById('admin-label-aubary').innerText = cand2Name + ':';

            const logoUrl = imgs.logo || DEFAULT_IMAGES.logo;
            const bgUrl = imgs.bg || DEFAULT_IMAGES.bg;
            const jefeesUrl = imgs.jefees || DEFAULT_IMAGES.jefees;
            const aubaryUrl = imgs.aubary || DEFAULT_IMAGES.aubary;

            document.getElementById('nav-logo-img').src = logoUrl;
