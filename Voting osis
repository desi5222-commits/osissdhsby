<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SDH Surabaya - Student Council Election 2026/2027</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Plus Jakarta Sans & Outfit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        sdh: {
                            navy: '#0b1d3a',
                            blue: '#1e3a8a',
                            gold: '#d97706',
                            goldlight: '#f59e0b',
                            crimson: '#991b1b',
                            glass: 'rgba(15, 23, 42, 0.75)',
                            cardbg: 'rgba(30, 41, 59, 0.65)'
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        display: ['Outfit', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <!-- Global Image Error Handlers -->
    <script>
        function handleCandidateError(imgElement, candidateName, colorHex) {
            imgElement.onerror = null;
            const cleanHex = (colorHex || 'd97706').replace('#', '');
            imgElement.src = `https://placehold.co/400x500/0b1d3a/${cleanHex}?text=${encodeURIComponent(candidateName)}+%28SDH%29`;
        }

        function handleLogoError(imgElement) {
            imgElement.onerror = null;
            imgElement.src = `https://placehold.co/400x120/0b1d3a/f59e0b?text=SDH+SURABAYA`;
        }
    </script>

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #070d19;
            color: #f8fafc;
            overflow-x: hidden;
        }

        .font-display {
            font-family: 'Outfit', sans-serif;
        }

        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
        }

        .glass-card {
            background: rgba(30, 41, 59, 0.65);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .glass-card:hover {
            border-color: rgba(245, 158, 11, 0.4);
            box-shadow: 0 10px 30px rgba(217, 119, 6, 0.15);
        }

        .bg-school-overlay {
            background-image: radial-gradient(circle at center, rgba(11, 29, 58, 0.6) 0%, rgba(7, 13, 25, 0.92) 100%), var(--bg-img-url, url('SDH Building.jpg'));
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
        }

        @keyframes pulse-slow {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.85; transform: scale(1.02); }
        }

        .pulse-live {
            animation: pulse-slow 3s infinite ease-in-out;
        }

        .vote-number {
            transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }

        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(217, 119, 6, 0.5);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: rgba(217, 119, 6, 0.8);
        }
    </style>
</head>
<body class="h-full flex flex-col justify-between bg-school-overlay min-h-screen text-slate-100 relative" id="body-bg">

    <header class="fixed top-0 left-0 right-0 z-50 px-4 py-3 bg-slate-950/80 backdrop-blur-md border-b border-slate-800/80 flex justify-between items-center shadow-lg">
        <div class="flex items-center space-x-3">
            <div id="sdh-header-logo-container" class="h-10 px-2 rounded-xl bg-slate-950/90 border border-amber-500/30 flex items-center justify-center overflow-hidden shrink-0">
                <img id="nav-logo-img" src="https://lh3.googleusercontent.com/d/1cdplHG-U_A5VvcRZOegWVAsrmA_ITZa5" alt="SDH Logo" onerror="handleLogoError(this)" class="h-full w-auto object-contain">
            </div>
            <div>
                <h1 id="header-school-name" class="text-xs sm:text-sm font-bold tracking-wider text-amber-400 font-display uppercase">Sekolah Dian Harapan Surabaya</h1>
                <p id="header-election-year" class="text-[10px] sm:text-xs text-slate-400">Student Council Election 2026/2027</p>
            </div>
        </div>

        <div class="flex items-center space-x-1 sm:space-x-2 bg-slate-900/90 p-1 rounded-xl border border-slate-800 text-xs font-semibold">
            <button id="btn-view-main" onclick="switchView('main')" class="px-2.5 sm:px-3 py-1.5 rounded-lg transition-all flex items-center space-x-1.5 bg-amber-500 text-slate-950 font-bold shadow-md">
                <i class="fa-solid fa-tv text-xs"></i>
                <span class="hidden md:inline">Main Screen</span>
            </button>
            <button id="btn-view-voting" onclick="switchView('voting')" class="px-2.5 sm:px-3 py-1.5 rounded-lg transition-all flex items-center space-x-1.5 text-slate-300 hover:text-white hover:bg-slate-800">
                <i class="fa-solid fa-check-to-slot text-xs"></i>
                <span class="hidden md:inline">Voting Device</span>
            </button>
            <button id="btn-view-admin" onclick="openAdminModal()" class="px-2.5 sm:px-3 py-1.5 rounded-lg transition-all flex items-center space-x-1.5 text-slate-400 hover:text-amber-400 hover:bg-slate-800">
                <i class="fa-solid fa-user-gear text-xs"></i>
                <span class="hidden md:inline">Admin</span>
            </button>
            <button onclick="toggleFullScreen()" title="Toggle Fullscreen" class="px-2 py-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-slate-800">
                <i class="fa-solid fa-expand text-xs"></i>
            </button>
        </div>
    </header>

    <main class="pt-16 pb-6 px-3 sm:px-6 flex-grow flex flex-col justify-center items-center w-full max-w-7xl mx-auto my-auto relative z-10">

        <!-- ========================================================================= -->
        <!-- INTERFACE A: MAIN DISPLAY / LIVE ELECTION SCREEN (Projector / TV 16:9)    -->
        <!-- ========================================================================= -->
        <section id="view-main-display" class="w-full flex flex-col justify-between items-center py-4 min-h-[85vh]">
            <div class="text-center space-y-2 mb-4 sm:mb-6 animate-fade-in">
                <!-- Status Badge -->
                <div class="inline-flex items-center space-x-2 px-4 py-1.5 rounded-full bg-slate-900/80 border border-slate-700/80 shadow-inner mb-2">
                    <span id="live-indicator-dot" class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
                    <span id="live-indicator-text" class="text-xs font-bold tracking-widest uppercase text-emerald-400">LIVE VOTING</span>
                </div>

                <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-5 mb-1">
                    <div id="sdh-main-logo-box" class="h-16 sm:h-20 px-3 bg-slate-950/90 border-2 border-amber-500/40 p-2 rounded-2xl shadow-xl flex items-center justify-center overflow-hidden shrink-0">
                        <img id="main-logo-img" src="https://lh3.googleusercontent.com/d/1cdplHG-U_A5VvcRZOegWVAsrmA_ITZa5" alt="SDH Logo" onerror="handleLogoError(this)" class="h-full w-auto object-contain">
                    </div>
                    <div class="text-center sm:text-left">
                        <h2 id="main-display-school-name" class="text-xs sm:text-sm font-bold tracking-widest text-amber-400/90 font-display uppercase">SEKOLAH DIAN HARAPAN SURABAYA</h2>
                        <h1 id="main-display-title" class="text-xl sm:text-3xl lg:text-4xl font-extrabold tracking-tight text-white font-display">STUDENT COUNCIL PRESIDENT ELECTION</h1>
                        <p id="main-display-year" class="text-xs sm:text-sm font-semibold text-slate-300">ACADEMIC YEAR 2026 / 2027</p>
                    </div>
                </div>

                <!-- Helper Prompt for users who want to vote -->
                <div class="mt-2 inline-flex items-center space-x-2 px-4 py-2 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-medium cursor-pointer hover:bg-amber-500/20 transition-all" onclick="switchView('voting')">
                    <i class="fa-solid fa-circle-info text-amber-400"></i>
                    <span>Ini adalah Layar Tampilan Hasil Live. <u>Klik di sini untuk berpindah ke Perangkat Voting</u> dan memberikan suara.</span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-10 w-full max-w-5xl my-auto">

                <!-- Candidate 1: JEFEES -->
                <div id="card-main-jefees" onclick="promptSwitchToVoting()" class="glass-panel rounded-2xl p-6 flex flex-col items-center text-center relative overflow-hidden group transition-all duration-300 border-slate-700/60 hover:border-amber-500/50 cursor-pointer" title="Klik untuk membuka perangkat voting">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
                    
                    <div class="relative w-44 h-52 sm:w-56 sm:h-64 lg:w-64 lg:h-72 rounded-2xl overflow-hidden border-2 border-amber-500/40 shadow-2xl mb-5 group-hover:scale-[1.02] transition-transform duration-300 bg-slate-900 flex items-center justify-center">
                        <img id="photo-main-jefees" src="Jefees.jpg" alt="JEFEES" onerror="handleCandidateError(this, 'JEFEES', '#d97706')" class="w-full h-full object-cover object-top">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent pointer-events-none"></div>
                        <span id="tagline-main-jefees" class="absolute bottom-3 left-3 bg-amber-500 text-slate-950 text-xs font-black px-2.5 py-1 rounded-md shadow z-10">CANDIDATE 01</span>
                    </div>

                    <h3 id="name-main-jefees" class="text-2xl sm:text-3xl font-extrabold text-white font-display tracking-wide mb-3">JEFEES</h3>

                    <div class="w-full bg-slate-900/80 rounded-xl p-4 border border-slate-800 shadow-inner flex flex-col items-center">
                        <div class="text-4xl sm:text-5xl lg:text-6xl font-black text-amber-400 font-display tracking-tight vote-number" id="count-main-jefees">0</div>
                        <span class="text-xs sm:text-sm font-semibold tracking-wider text-slate-400 uppercase mt-1">TOTAL VOTES</span>
                        <div class="w-full bg-slate-800 h-2 rounded-full mt-3 overflow-hidden">
                            <div id="bar-main-jefees" class="bg-gradient-to-r from-amber-600 to-amber-400 h-full rounded-full transition-all duration-700" style="width: 0%"></div>
                        </div>
                        <span id="percent-main-jefees" class="text-[11px] font-bold text-amber-400/80 mt-1">0%</span>
                    </div>
                </div>

                <!-- Candidate 2: AUBARY -->
                <div id="card-main-aubary" onclick="promptSwitchToVoting()" class="glass-panel rounded-2xl p-6 flex flex-col items-center text-center relative overflow-hidden group transition-all duration-300 border-slate-700/60 hover:border-blue-500/50 cursor-pointer" title="Klik untuk membuka perangkat voting">
                    <div class="absolute top-0 right-0 w-32 h-32 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

                    <div class="relative w-44 h-52 sm:w-56 sm:h-64 lg:w-64 lg:h-72 rounded-2xl overflow-hidden border-2 border-blue-500/40 shadow-2xl mb-5 group-hover:scale-[1.02] transition-transform duration-300 bg-slate-900 flex items-center justify-center">
                        <img id="photo-main-aubary" src="Aubary.jpg" alt="AUBARY" onerror="handleCandidateError(this, 'AUBARY', '#2563eb')" class="w-full h-full object-cover object-top">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent pointer-events-none"></div>
                        <span id="tagline-main-aubary" class="absolute bottom-3 left-3 bg-blue-500 text-white text-xs font-black px-2.5 py-1 rounded-md shadow z-10">CANDIDATE 02</span>
                    </div>

                    <h3 id="name-main-aubary" class="text-2xl sm:text-3xl font-extrabold text-white font-display tracking-wide mb-3">AUBARY</h3>

                    <div class="w-full bg-slate-900/80 rounded-xl p-4 border border-slate-800 shadow-inner flex flex-col items-center">
                        <div class="text-4xl sm:text-5xl lg:text-6xl font-black text-blue-400 font-display tracking-tight vote-number" id="count-main-aubary">0</div>
                        <span class="text-xs sm:text-sm font-semibold tracking-wider text-slate-400 uppercase mt-1">TOTAL VOTES</span>
                        <div class="w-full bg-slate-800 h-2 rounded-full mt-3 overflow-hidden">
                            <div id="bar-main-aubary" class="bg-gradient-to-r from-blue-600 to-blue-400 h-full rounded-full transition-all duration-700" style="width: 0%"></div>
                        </div>
                        <span id="percent-main-aubary" class="text-[11px] font-bold text-blue-400/80 mt-1">0%</span>
                    </div>

                </div>

            </div>

            <div class="mt-8 text-center space-y-1">
                <p class="text-lg sm:text-xl font-black tracking-widest text-amber-400 font-display uppercase">YOUR VOICE MATTERS</p>
                <p id="main-footer-subtext" class="text-xs text-slate-400 font-medium">Student Council President Election • Sekolah Dian Harapan Surabaya • 2026/2027</p>
            </div>
        </section>

        <!-- ========================================================================= -->
        <!-- INTERFACE B: VOTING DEVICE INTERFACE (For Mobile/Tablet/Laptop)          -->
        <!-- ========================================================================= -->
        <section id="view-voting-device" class="w-full max-w-xl mx-auto flex flex-col justify-center items-center py-4 hidden">
            
            <div class="w-full text-center mb-6 bg-slate-900/80 p-5 rounded-2xl border border-slate-800 shadow-lg backdrop-blur-md">
                <div class="h-14 px-3 mx-auto mb-3 bg-slate-950/90 border border-amber-500/40 p-1.5 rounded-xl inline-flex items-center justify-center">
                    <img id="voter-logo-img" src="https://lh3.googleusercontent.com/d/1cdplHG-U_A5VvcRZOegWVAsrmA_ITZa5" alt="SDH Logo" onerror="handleLogoError(this)" class="h-full w-auto object-contain">
                </div>
                <h2 id="voter-header-school" class="text-xs font-extrabold text-amber-400 font-display uppercase tracking-wider">SEKOLAH DIAN HARAPAN SURABAYA</h2>
                <h1 id="voter-header-title" class="text-xl font-black text-white font-display mt-0.5">STUDENT COUNCIL PRESIDENT ELECTION</h1>
                <p id="voter-header-year" class="text-xs text-slate-400 font-semibold">ACADEMIC YEAR 2026/2027</p>
            </div>

            <!-- Closed Election Banner -->
            <div id="voting-closed-banner" class="hidden w-full glass-panel p-8 rounded-2xl text-center space-y-3 border-amber-500/30">
                <div class="w-16 h-16 mx-auto rounded-full bg-amber-500/10 text-amber-400 flex items-center justify-center text-2xl">
                    <i class="fa-solid fa-lock"></i>
                </div>
                <h3 class="text-xl font-bold text-white font-display">Voting is Currently Closed</h3>
                <p class="text-sm text-slate-300">The election is either paused or has concluded. Please follow instructions from the election committee.</p>
            </div>

            <div id="already-voted-banner" class="hidden w-full glass-panel p-8 rounded-2xl text-center space-y-4 border-emerald-500/30">
                <div class="w-16 h-16 mx-auto rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center text-3xl">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <h3 class="text-2xl font-black text-white font-display">VOTE SUBMITTED</h3>
                <p class="text-sm text-slate-300">Thank you for participating in the <span id="thankyou-school-name" class="text-amber-400 font-bold">Sekolah Dian Harapan</span> Student Council Election!</p>
                <p class="text-xs text-slate-400 italic">Your vote has been securely recorded.</p>

                <div id="kiosk-reset-box" class="pt-4 border-t border-slate-800/80 space-y-3">
                    <p class="text-xs font-semibold text-amber-300">
                        <i class="fa-solid fa-arrows-rotate mr-1 animate-spin"></i> Resetting for next voter in <span id="kiosk-countdown-num" class="text-white font-extrabold text-base px-2 py-0.5 bg-amber-500/20 rounded border border-amber-500/40">4</span>s...
                    </p>
                    <button onclick="resetScreenForNextVoter()" class="w-full py-3.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-sm rounded-xl shadow-lg shadow-amber-500/20 transition-all active:scale-95 flex items-center justify-center space-x-2">
                        <i class="fa-solid fa-user-plus text-base"></i>
                        <span>CAST NEXT VOTE NOW</span>
                    </button>
                </div>
            </div>

            <div id="voting-active-area" class="w-full space-y-4">
                <div class="text-center mb-2">
                    <p class="text-sm sm:text-base font-bold text-amber-300 bg-amber-500/10 px-4 py-2 rounded-xl inline-block border border-amber-500/20 shadow-sm">
                        <i class="fa-solid fa-hand-pointer mr-1.5"></i> Choose ONE candidate for Student Council President:
                    </p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                    <!-- Candidate 1 Choice Button -->
                    <div onclick="selectCandidate('candidate1')" class="glass-card rounded-2xl p-5 flex flex-col items-center text-center cursor-pointer group active:scale-95 transition-all relative overflow-hidden border-slate-700/70 hover:border-amber-500">
                        <div class="w-36 h-44 sm:w-40 sm:h-48 rounded-xl overflow-hidden border-2 border-amber-500/40 mb-3 bg-slate-900 shadow-md flex items-center justify-center">
                            <img id="photo-voter-jefees" src="Jefees.jpg" alt="JEFEES" onerror="handleCandidateError(this, 'JEFEES', '#d97706')" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform">
                        </div>
                        <span id="tagline-voter-jefees" class="text-[10px] font-bold uppercase tracking-wider text-amber-400 bg-amber-500/10 px-2.5 py-0.5 rounded border border-amber-500/30 mb-1">Candidate 01</span>
                        <h3 id="name-voter-jefees" class="text-xl font-black text-white font-display">JEFEES</h3>
                        <p id="subtext-voter-jefees" class="text-xs text-slate-400 mt-1 font-medium">Click to select Jefees</p>
                        <button id="btn-voter-jefees" onclick="event.stopPropagation(); selectCandidate('candidate1');" class="mt-3 w-full py-2.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-extrabold text-xs rounded-xl shadow group-hover:shadow-amber-500/20">
                            VOTE FOR JEFEES
                        </button>
                    </div>

                    <!-- Candidate 2 Choice Button -->
                    <div onclick="selectCandidate('candidate2')" class="glass-card rounded-2xl p-5 flex flex-col items-center text-center cursor-pointer group active:scale-95 transition-all relative overflow-hidden border-slate-700/70 hover:border-blue-500">
                        <div class="w-36 h-44 sm:w-40 sm:h-48 rounded-xl overflow-hidden border-2 border-blue-500/40 mb-3 bg-slate-900 shadow-md flex items-center justify-center">
                            <img id="photo-voter-aubary" src="Aubary.jpg" alt="AUBARY" onerror="handleCandidateError(this, 'AUBARY', '#2563eb')" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform">
                        </div>
                        <span id="tagline-voter-aubary" class="text-[10px] font-bold uppercase tracking-wider text-blue-400 bg-blue-500/10 px-2.5 py-0.5 rounded border border-blue-500/30 mb-1">Candidate 02</span>
                        <h3 id="name-voter-aubary" class="text-xl font-black text-white font-display">AUBARY</h3>
                        <p id="subtext-voter-aubary" class="text-xs text-slate-400 mt-1 font-medium">Click to select Aubary</p>
                        <button id="btn-voter-aubary" onclick="event.stopPropagation(); selectCandidate('candidate2');" class="mt-3 w-full py-2.5 bg-blue-500 hover:bg-blue-400 text-white font-extrabold text-xs rounded-xl shadow group-hover:shadow-blue-500/20">
                            VOTE FOR AUBARY
                        </button>
                    </div>

                </div>

                <p class="text-[11px] text-center text-slate-400 italic mt-4">
                    <i class="fa-solid fa-shield-halved text-amber-500/80 mr-1"></i> SDH Surabaya Voting Integrity System • Continuous Kiosk Voting Enabled
                </p>
            </div>

        </section>

    </main>

    <div id="modal-confirm-vote" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md hidden animate-fade-in">
        <div class="glass-panel w-full max-w-md rounded-2xl p-6 border-amber-500/40 shadow-2xl space-y-4 text-center">
            <div class="w-16 h-16 mx-auto rounded-full bg-amber-500/20 border border-amber-500/40 text-amber-400 flex items-center justify-center text-2xl">
                <i class="fa-solid fa-vote-yea"></i>
            </div>
            
            <div>
                <h3 class="text-xs font-extrabold uppercase tracking-widest text-slate-400">Confirm Your Choice</h3>
                <p class="text-2xl font-black text-white font-display mt-1">You selected <span id="confirm-candidate-name" class="text-amber-400">CANDIDATE</span></p>
            </div>

            <p class="text-sm text-slate-300">Are you sure you want to submit your vote? Once submitted, your selection cannot be changed.</p>

            <div class="grid grid-cols-2 gap-3 pt-2">
                <button onclick="closeConfirmModal()" class="py-3 px-4 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 font-bold text-sm transition-colors border border-slate-700">
                    CANCEL
                </button>
                <button id="btn-submit-final-vote" onclick="submitFinalVote()" class="py-3 px-4 rounded-xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-sm shadow-lg shadow-amber-500/20 transition-transform active:scale-95">
                    SUBMIT VOTE
                </button>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- INTERFACE C: ADMIN CONTROL PANEL MODAL                                    -->
    <!-- ========================================================================= -->
    <div id="modal-admin-panel" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/85 backdrop-blur-md hidden overflow-y-auto">
        <div class="glass-panel w-full max-w-2xl rounded-2xl p-6 border-slate-700/80 shadow-2xl space-y-6 my-auto">
            
            <div class="flex justify-between items-center border-b border-slate-800 pb-4">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-400 flex items-center justify-center text-xl">
                        <i class="fa-solid fa-sliders"></i>
                    </div>
                    <div>
                        <h3 class="text-lg font-black text-white font-display">Election Control Panel</h3>
                        <p class="text-xs text-slate-400">Protected Admin System • Editable Election Settings</p>
                    </div>
                </div>
