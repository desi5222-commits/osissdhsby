            const totalVotes = jefeesVotes + aubaryVotes;

            animateCount('count-main-jefees', jefeesVotes);
            animateCount('count-main-aubary', aubaryVotes);

            const jefeesPercent = totalVotes > 0 ? Math.round((jefeesVotes / totalVotes) * 100) : 0;
